@model IEnumerable<russelregadillo.Models.Instructor>

@{
    ViewData["Title"] = "Instructor Information";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Instructor List</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <style>
            * {
                font-family: 'Poppins', sans-serif;
            }

            body {
                background: #F9F3F4;
                color: #321B20;
            }

            .main {
                margin-left: 260px;
                padding: 35px;
            }

            .top {
                display: flex;
                justify-content: space-between;
                align-items: center;
                margin-bottom: 28px;
            }

            h3 {
                font-weight: 700;
            }

            .muted {
                color: #987B82;
                font-size: 12px;
            }

            .panel {
                background: white;
                border: 1px solid #F0E1E4;
                border-radius: 18px;
                padding: 24px;
                box-shadow: 0 5px 20px rgba(74,16,28,.04);
            }

            .btn-maroon {
                background: #701C2C;
                color: white;
                border: 0;
                border-radius: 9px;
                padding: 11px 17px;
                font-size: 12px;
                font-weight: 600;
                text-decoration: none;
            }

                .btn-maroon:hover {
                    background: #4A101C;
                    color: white;
                }

            .table {
                font-size: 12px;
                vertical-align: middle;
            }

                .table thead th {
                    background: #F9EFF1;
                    color: #701C2C;
                    padding: 15px 12px;
                    border: 0;
                    white-space: nowrap;
                }

                .table tbody td {
                    padding: 14px 12px;
                    color: #65434B;
                }

                .table tbody tr:hover {
                    background: #FFFAFB;
                }

            .action {
                text-decoration: none;
                padding: 6px 9px;
                border-radius: 7px;
                margin: 2px;
                display: inline-block;
            }

            .view {
                color: #701C2C;
                background: #F9EDEF;
            }

            .edit {
                color: #98651D;
                background: #FFF4DF;
            }

            .delete {
                color: #B42332;
                background: #FCE8EA;
            }

            .sidebar {
                width: 260px;
                height: 100vh;
                position: fixed;
                background: #4A101C;
                top: 0;
                left: 0;
                padding: 28px 20px;
                color: white;
            }

            .brand {
                font-weight: 700;
                padding: 10px;
                margin-bottom: 35px;
            }

            .menu-label {
                color: #C99AA4;
                font-size: 10px;
                letter-spacing: 2px;
                padding: 10px;
            }

            .nav-link-custom {
                display: block;
                color: #E8CFD4;
                text-decoration: none;
                padding: 13px 15px;
                border-radius: 10px;
                margin-bottom: 7px;
                font-size: 13px;
            }

                .nav-link-custom:hover, .nav-link-custom.active {
                    background: #701C2C;
                    color: white;
                }

            @@media(max-width:850px) {
                .sidebar {
                    width: 75px;
                    padding: 20px 8px;
                }

                .brand span, .nav-text, .menu-label {
                    display: none;
                }

                .nav-link-custom {
                    text-align: center;
                }

                .main {
                    margin-left: 75px;
                    padding: 20px 12px;
                }

                .top {
                    align-items: flex-start;
                    gap: 12px;
                    flex-wrap: wrap;
                }
            }
    </style>
</head>
<body>
    <aside class="sidebar">
        <div class="brand"><i class="bi bi-mortarboard-fill me-2"></i><span>Instructor SIS</span></div>
        <div class="menu-label">MAIN MENU</div>
        <a asp-controller="Dashboard" asp-action="Index" class="nav-link-custom"><i class="bi bi-grid-fill me-2"></i><span class="nav-text">Dashboard</span></a>
        <a asp-controller="Instructor" asp-action="Index" class="nav-link-custom active"><i class="bi bi-people-fill me-2"></i><span class="nav-text">Instructors</span></a>
        <div class="menu-label mt-5">ACCOUNT</div>
        <a asp-controller="Account" asp-action="Logout" class="nav-link-custom"><i class="bi bi-box-arrow-left me-2"></i><span class="nav-text">Logout</span></a>
    </aside>

    <main class="main">
        <div class="top">
            <div>
                <h3>Instructor Information</h3>
                <p class="muted">Manage and organize all instructor records.</p>
            </div>
            <a asp-action="Create" class="btn-maroon"><i class="bi bi-plus-lg me-1"></i> Add Instructor</a>
        </div>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success">@TempData["SuccessMessage"]</div>
        }

        <section class="panel">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h6 class="fw-bold mb-0">Instructor Records</h6>
                <span class="muted">Total: @Model.Count()</span>
            </div>
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Full Name</th>
                            <th>Age</th>
                            <th>Designation</th>
                            <th>Gender</th>
                            <th>Contact</th>
                            <th>Majorship</th>
                            <th>Email</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Any())
                        {
                            @foreach (var instructor in Model)
                            {
                                <tr>
                                    <td>@instructor.InstructorId</td>
                                    <td class="fw-semibold">@instructor.FullName</td>
                                    <td>@instructor.Age</td>
                                    <td>@instructor.Designation</td>
                                    <td>@instructor.Gender</td>
                                    <td>@instructor.ContactNumber</td>
                                    <td>@instructor.Majorship</td>
                                    <td>@instructor.EmailAddress</td>
                                    <td class="text-nowrap">
                                        <a asp-action="Details" asp-route-id="@instructor.InstructorId" class="action view" title="View"><i class="bi bi-eye"></i></a>
                                        <a asp-action="Edit" asp-route-id="@instructor.InstructorId" class="action edit" title="Edit"><i class="bi bi-pencil"></i></a>
                                        <a asp-action="Delete" asp-route-id="@instructor.InstructorId" class="action delete" title="Delete"><i class="bi bi-trash"></i></a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr><td colspan="9" class="text-center py-5 muted">No instructor records found. Click Add Instructor to get started.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    </main>
</body>
</html>
