@model russelregadillo.Models.Instructor
@{
    ViewData["Title"] = "Delete Instructor";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Delete Instructor</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <style>
            * {
                font-family: 'Poppins',sans-serif;
            }

            body {
                background: #F9F3F4;
                min-height: 100vh;
                display: flex;
                align-items: center;
                justify-content: center;
                padding: 20px;
                color: #321B20;
            }

            .delete-card {
                width: 100%;
                max-width: 550px;
                background: white;
                border-radius: 20px;
                padding: 40px;
                text-align: center;
                box-shadow: 0 10px 35px #4A101C10;
            }

            .warning-icon {
                width: 75px;
                height: 75px;
                margin: 0 auto 22px;
                border-radius: 50%;
                background: #FCE8EA;
                color: #B42332;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 32px;
            }

            h3 {
                font-weight: 700;
                color: #4A101C;
            }

            .subtitle {
                color: #987B82;
                font-size: 12px;
                line-height: 1.8;
            }

            .instructor-info {
                background: #FCF7F8;
                padding: 18px;
                border-radius: 12px;
                text-align: left;
                margin: 25px 0;
            }

                .instructor-info small {
                    color: #987B82;
                    font-size: 10px;
                }

                .instructor-info strong {
                    color: #4A101C;
                    font-size: 14px;
                    display: block;
                    margin-bottom: 12px;
                }

            .btn-delete {
                background: #B42332;
                color: white;
                border: 0;
                padding: 12px 20px;
                border-radius: 9px;
                font-size: 12px;
                font-weight: 600;
            }

                .btn-delete:hover {
                    background: #8E1724;
                    color: white;
                }

            .btn-cancel {
                background: #F9EFF1;
                color: #701C2C;
                padding: 12px 20px;
                border-radius: 9px;
                text-decoration: none;
                font-size: 12px;
                font-weight: 600;
            }
    </style>
</head>
<body>
    <div class="delete-card">
        <div class="warning-icon">!</div>
        <h3>Delete Instructor?</h3>
        <p class="subtitle">Are you sure you want to delete this instructor record? This action cannot be undone.</p>

        <div class="instructor-info">
            <small>Instructor ID</small>
            <strong>@Model.InstructorId</strong>
            <small>Full Name</small>
            <strong>@Model.FullName</strong>
            <small>Email Address</small>
            <strong>@Model.EmailAddress</strong>
        </div>

        <form asp-action="Delete" asp-route-id="@Model.InstructorId" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="InstructorId" />
            <div class="d-flex justify-content-center gap-2">
                <a asp-action="Index" class="btn-cancel">Cancel</a>
                <button type="submit" class="btn-delete">Yes, Delete</button>
            </div>
        </form>
    </div>
</body>
</html>
