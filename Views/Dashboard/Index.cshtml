@{
    ViewData["Title"] = "Dashboard";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Dashboard | Instructor Information System</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <style>
            * {
                font-family: 'Poppins', sans-serif;
            }

            body {
                margin: 0;
                background: #F9F3F4;
                color: #321B20;
            }

            .sidebar {
                width: 260px;
                height: 100vh;
                position: fixed;
                left: 0;
                top: 0;
                background: #4A101C;
                color: white;
                padding: 28px 20px;
                display: flex;
                flex-direction: column;
                z-index: 100;
            }

            .brand {
                display: flex;
                align-items: center;
                gap: 12px;
                padding: 5px 10px 35px;
            }

            .brand-icon {
                background: #963849;
                width: 43px;
                height: 43px;
                border-radius: 13px;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 22px;
            }

            .brand h5 {
                font-size: 15px;
                font-weight: 700;
                margin: 0;
            }

            .brand small {
                color: #DDBBC2;
                font-size: 10px;
            }

            .menu-label {
                color: #C99AA4;
                font-size: 10px;
                font-weight: 700;
                letter-spacing: 2px;
                padding: 0 12px;
                margin-bottom: 12px;
            }

            .nav-link-custom {
                display: flex;
                align-items: center;
                gap: 13px;
                color: #E8CFD4;
                padding: 13px 15px;
                border-radius: 11px;
                text-decoration: none;
                font-size: 13px;
                margin-bottom: 7px;
                transition: .25s;
            }

                .nav-link-custom:hover,
                .nav-link-custom.active {
                    background: #701C2C;
                    color: white;
                }

                .nav-link-custom i {
                    font-size: 18px;
                }

            .sidebar-bottom {
                margin-top: auto;
            }

            .main-content {
                margin-left: 260px;
                padding: 30px 38px;
            }

            .topbar {
                display: flex;
                justify-content: space-between;
                align-items: center;
                margin-bottom: 35px;
            }

                .topbar h4 {
                    font-weight: 700;
                    margin: 0;
                    font-size: 22px;
                }

                .topbar p {
                    color: #987B82;
                    font-size: 12px;
                    margin: 5px 0 0;
                }

            .profile {
                display: flex;
                align-items: center;
                gap: 12px;
            }

            .profile-icon {
                background: #E8C8CE;
                color: #701C2C;
                width: 42px;
                height: 42px;
                border-radius: 50%;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 18px;
            }

            .profile strong {
                font-size: 12px;
                display: block;
            }

            .profile small {
                font-size: 10px;
                color: #987B82;
            }

            .welcome-card {
                background: linear-gradient(120deg, #4A101C, #842B40);
                color: white;
                padding: 35px 38px;
                border-radius: 20px;
                margin-bottom: 30px;
                position: relative;
                overflow: hidden;
            }

                .welcome-card::after {
                    content: "✦";
                    position: absolute;
                    right: 55px;
                    top: -30px;
                    font-size: 190px;
                    color: rgba(255,255,255,.06);
                }

                .welcome-card h2 {
                    font-weight: 700;
                    font-size: 25px;
                    margin-bottom: 10px;
                }

                .welcome-card p {
                    color: #F0D8DD;
                    font-size: 12px;
                    margin: 0;
                    line-height: 1.8;
                }

            .section-heading {
                font-size: 17px;
                font-weight: 700;
                margin-bottom: 18px;
            }

            .stat-card {
                background: white;
                border: 1px solid #F0E1E4;
                border-radius: 17px;
                padding: 22px;
                height: 100%;
                box-shadow: 0 5px 20px rgba(74,16,28,.03);
            }

            .stat-icon {
                width: 43px;
                height: 43px;
                background: #F9EDEF;
                color: #842B40;
                display: flex;
                align-items: center;
                justify-content: center;
                border-radius: 12px;
                font-size: 20px;
                margin-bottom: 18px;
            }

            .stat-card small {
                color: #987B82;
                font-size: 11px;
            }

            .stat-card h3 {
                font-size: 27px;
                font-weight: 700;
                margin-top: 5px;
                color: #4A101C;
            }

            .action-card {
                background: white;
                border: 1px solid #F0E1E4;
                border-radius: 17px;
                padding: 25px;
                height: 100%;
                transition: .25s;
            }

                .action-card:hover {
                    transform: translateY(-4px);
                    box-shadow: 0 10px 25px rgba(74,16,28,.08);
                }

            .action-icon {
                width: 48px;
                height: 48px;
                background: #F9EDEF;
                color: #842B40;
                border-radius: 14px;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 22px;
                margin-bottom: 18px;
            }

            .action-card h6 {
                font-weight: 700;
                font-size: 14px;
            }

            .action-card p {
                font-size: 11px;
                color: #987B82;
                line-height: 1.7;
            }

            .action-btn {
                display: inline-block;
                background: #701C2C;
                color: white;
                text-decoration: none;
                border-radius: 9px;
                padding: 10px 16px;
                font-size: 11px;
                font-weight: 600;
                margin-top: 8px;
            }

                .action-btn:hover {
                    background: #4A101C;
                    color: white;
                }

            .footer {
                color: #A88F95;
                text-align: center;
                font-size: 10px;
                padding: 35px 0 10px;
            }

            @@media(max-width: 850px) {
                .sidebar {
                    width: 75px;
                    padding: 25px 10px;
                }

                .brand {
                    justify-content: center;
                    padding: 5px 0 35px;
                }

                .brand-text, .menu-label, .nav-text {
                    display: none;
                }

                .nav-link-custom {
                    justify-content: center;
                    padding: 14px 5px;
                }

                .main-content {
                    margin-left: 75px;
                    padding: 25px 18px;
                }
            }

            @@media(max-width: 576px) {
                .topbar {
                    align-items: flex-start;
                }

                    .topbar h4 {
                        font-size: 17px;
                    }

                .profile-text {
                    display: none;
                }

                .welcome-card {
                    padding: 27px 22px;
                }

                    .welcome-card h2 {
                        font-size: 20px;
                    }
            }
    </style>
</head>

<body>

    <!-- SIDEBAR -->
    <aside class="sidebar">
        <div class="brand">
            <div class="brand-icon">
                <i class="bi bi-mortarboard-fill"></i>
            </div>
            <div class="brand-text">
                <h5>Instructor SIS</h5>
                <small>MANAGEMENT SYSTEM</small>
            </div>
        </div>

        <div class="menu-label">MAIN MENU</div>

        <a asp-controller="Dashboard" asp-action="Index" class="nav-link-custom active">
            <i class="bi bi-grid-fill"></i>
            <span class="nav-text">Dashboard</span>
        </a>

        <a asp-controller="Instructor" asp-action="Index" class="nav-link-custom">
            <i class="bi bi-people-fill"></i>
            <span class="nav-text">Instructors</span>
        </a>

        <div class="sidebar-bottom">
            <div class="menu-label">ACCOUNT</div>

            <a asp-controller="Account" asp-action="Logout" class="nav-link-custom">
                <i class="bi bi-box-arrow-left"></i>
                <span class="nav-text">Logout</span>
            </a>
        </div>
    </aside>

    <!-- MAIN CONTENT -->
    <main class="main-content">

        <div class="topbar">
            <div>
                <h4>Dashboard</h4>
                <p>Welcome to your management workspace.</p>
            </div>

            <div class="profile">
                <div class="profile-icon">
                    <i class="bi bi-person-fill"></i>
                </div>
                <div class="profile-text">
                    <strong>Administrator</strong>
                    <small>System Admin</small>
                </div>
            </div>
        </div>

        <!-- WELCOME -->
        <section class="welcome-card">
            <h2>Hey there! Welcome to Instructor SIS!💗</h2>
            <p>
                Your one-stop tambayan for all instructor information! No more kalat na records, no more hanap-hanap moments. 
                Everything is organized, easy to access, and safe—less stress, more progress! 😉
            </p>
        </section>

        <!-- STATISTICS -->
        <h5 class="section-heading">Overview</h5>

        <div class="row g-3 mb-4">
            <div class="col-md-4">
                <div class="stat-card">
                    <div class="stat-icon">
                        <i class="bi bi-people-fill"></i>
                    </div>
                    <small>Total Instructors</small>
                    <h3>—</h3>
                </div>
            </div>

            <div class="col-md-4">
                <div class="stat-card">
                    <div class="stat-icon">
                        <i class="bi bi-person-check-fill"></i>
                    </div>
                    <small>System Status</small>
                    <h3 style="font-size:20px;">Active</h3>
                </div>
            </div>

            <div class="col-md-4">
                <div class="stat-card">
                    <div class="stat-icon">
                        <i class="bi bi-shield-lock-fill"></i>
                    </div>
                    <small>Data Security</small>
                    <h3 style="font-size:20px;">Protected</h3>
                </div>
            </div>
        </div>

        <!-- QUICK ACTIONS -->
        <h5 class="section-heading">Quick Access</h5>

        <div class="row g-3">
            <div class="col-md-6">
                <div class="action-card">
                    <div class="action-icon">
                        <i class="bi bi-person-lines-fill"></i>
                    </div>
                    <h6>Instructor Information</h6>
                    <p>View, add, update, and manage instructor records in one place.</p>
                    <a asp-controller="Instructor" asp-action="Index" class="action-btn">
                        Manage Instructors <i class="bi bi-arrow-right"></i>
                    </a>
                </div>
            </div>

            <div class="col-md-6">
                <div class="action-card">
                    <div class="action-icon">
                        <i class="bi bi-person-plus-fill"></i>
                    </div>
                    <h6>Add New Instructor</h6>
                    <p>Register a new instructor and add their information to the system.</p>
                    <a asp-controller="Instructor" asp-action="Create" class="action-btn">
                        Add Instructor <i class="bi bi-arrow-right"></i>
                    </a>
                </div>
            </div>
        </div>

        <div class="footer">
            © 2026 Instructor Information System. All rights reserved.
        </div>

    </main>

</body>
</html>
