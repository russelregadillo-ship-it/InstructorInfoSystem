@model russelregadillo.Models.Instructor
@{
    ViewData["Title"] = "Edit Instructor";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Edit Instructor</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <style>
            * {
                font-family: 'Poppins',sans-serif;
            }

            body {
                background: #F9F3F4;
                padding: 35px 15px;
                color: #321B20;
            }

            .container-box {
                max-width: 850px;
                margin: auto;
                background: white;
                border-radius: 20px;
                padding: 35px;
                box-shadow: 0 10px 35px #4A101C10;
            }

            h3 {
                font-weight: 700;
                color: #4A101C;
            }

            .subtitle {
                color: #987B82;
                font-size: 12px;
                margin-bottom: 25px;
            }

            .form-label {
                font-size: 12px;
                font-weight: 600;
                color: #5B303A;
            }

            .form-control, .form-select {
                border: 1px solid #EBD9DD;
                border-radius: 9px;
                padding: 12px;
                font-size: 13px;
            }

                .form-control:focus, .form-select:focus {
                    border-color: #701C2C;
                    box-shadow: 0 0 0 3px #701C2C18;
                }

            .btn-maroon {
                background: #701C2C;
                color: white;
                border: 0;
                padding: 12px 22px;
                border-radius: 9px;
                font-size: 12px;
                font-weight: 600;
            }

                .btn-maroon:hover {
                    background: #4A101C;
                    color: white;
                }

            .btn-light-custom {
                background: #F9EFF1;
                color: #701C2C;
                padding: 12px 22px;
                border-radius: 9px;
                text-decoration: none;
                font-size: 12px;
                font-weight: 600;
            }
    </style>
</head>
<body>
    <div class="container-box">
        <h3>Edit Instructor</h3>
        <p class="subtitle">Update the instructor's information below.</p>

        <form asp-action="Edit" asp-route-id="@Model.InstructorId" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="InstructorId" />
            <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="FullName" class="form-label"></label>
                    <input asp-for="FullName" class="form-control" />
                    <span asp-validation-for="FullName" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Age" class="form-label"></label>
                    <input asp-for="Age" class="form-control" type="number" />
                    <span asp-validation-for="Age" class="text-danger small"></span>
                </div>
                <div class="col-12">
                    <label asp-for="Address" class="form-label"></label>
                    <input asp-for="Address" class="form-control" />
                    <span asp-validation-for="Address" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Designation" class="form-label"></label>
                    <input asp-for="Designation" class="form-control" />
                    <span asp-validation-for="Designation" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Gender" class="form-label"></label>
                    <select asp-for="Gender" class="form-select">
                        <option value="">Select gender</option>
                        <option>Male</option>
                        <option>Female</option>
                        <option>Prefer not to say</option>
                    </select>
                    <span asp-validation-for="Gender" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="ContactNumber" class="form-label"></label>
                    <input asp-for="ContactNumber" class="form-control" />
                    <span asp-validation-for="ContactNumber" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Majorship" class="form-label"></label>
                    <input asp-for="Majorship" class="form-control" />
                    <span asp-validation-for="Majorship" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="BachelorDegree" class="form-label"></label>
                    <input asp-for="BachelorDegree" class="form-control" />
                    <span asp-validation-for="BachelorDegree" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="EmailAddress" class="form-label"></label>
                    <input asp-for="EmailAddress" class="form-control" />
                    <span asp-validation-for="EmailAddress" class="text-danger small"></span>
                </div>
            </div>

            <div class="d-flex gap-2 justify-content-end mt-4">
                <a asp-action="Index" class="btn-light-custom">Cancel</a>
                <button type="submit" class="btn-maroon">Save Changes</button>
            </div>
        </form>
    </div>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/4.0.0/jquery.validate.unobtrusive.min.js"></script>
</body>
</html>

